local function PIMTMYA_fake_script() -- ModsFrame.FlyScript 
	local script = Instance.new('LocalScript', ModsFrame)

	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	
	local LocalPlayer = Players.LocalPlayer
	local Camera = workspace.CurrentCamera
	
	local frame = script.Parent
	local flyButton = frame:WaitForChild("Fly")
	local flySpeedBox = flyButton:WaitForChild("FlySpeedBox")
	
	local oldStroke = flyButton:FindFirstChild("UIStroke")
	
	if oldStroke then
		oldStroke:Destroy()
	end
	
	local uiStroke = Instance.new("UIStroke")
	uiStroke.Parent = flyButton
	uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	uiStroke.Transparency = 0
	uiStroke.Thickness = 0.6
	uiStroke.Color = Color3.fromRGB(255,255,255)
	
	local SPEED = 50
	local ACCEL = 12
	local TURN_SPEED = 14
	
	local Flying = false
	
	local Keys = {
		W = false,
		A = false,
		S = false,
		D = false
	}
	
	local FlyConnection
	local FlyPhysicsConnection
	
	local CurrentVel = Vector3.zero
	local CurrentYaw = 0
	local HoldY = nil
	
	local Humanoid
	local HRP
	
	local BLOCKED_STATES = {
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Freefall,
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Physics,
	}
	
	local function inputAllowed()
		if _G.keybindsBlocked then
			return false
		end
	
		return UserInputService:GetFocusedTextBox() == nil
	end
	
	local function getSpeed()
		local value = tonumber(flySpeedBox.Text)
	
		if value and value > 0 then
			return value
		end
	
		return 50
	end
	
	local function clearKeys()
		Keys.W = false
		Keys.A = false
		Keys.S = false
		Keys.D = false
	end
	
	local function flatLook()
		local look = Camera.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
	
		if flat.Magnitude < 0.01 then
			return Vector3.new(0,0,-1)
		end
	
		return flat.Unit
	end
	
	local function getMoveVector()
		local cam = Camera.CFrame
		local move = Vector3.zero
	
		if Keys.W then
			move += cam.LookVector
		end
	
		if Keys.S then
			move -= cam.LookVector
		end
	
		if Keys.A then
			move -= cam.RightVector
		end
	
		if Keys.D then
			move += cam.RightVector
		end
	
		if move.Magnitude > 0 then
			return move.Unit
		end
	
		return Vector3.zero
	end
	
	local function getFlyPart()
		local seat = Humanoid and Humanoid.SeatPart
	
		if seat and (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then
			local model = seat:FindFirstAncestorOfClass("Model")
	
			if model and model.PrimaryPart then
				return model.PrimaryPart
			end
	
			return seat
		end
	
		return HRP
	end
	
	local function applyVelocity(vel)
		local part = getFlyPart()
	
		if not part then
			return
		end
	
		part.AssemblyLinearVelocity = vel
		part.AssemblyAngularVelocity = Vector3.zero
	end
	
	local function lockHeight(y)
		if not HRP then
			return
		end
	
		local rotation = HRP.CFrame - HRP.CFrame.Position
	
		HRP.CFrame =
			CFrame.new(
				HRP.Position.X,
				y,
				HRP.Position.Z
			) * rotation
	
		applyVelocity(Vector3.zero)
	end
	
	local function setFallStates(enabled)
		if not Humanoid then
			return
		end
	
		for _, state in ipairs(BLOCKED_STATES) do
			Humanoid:SetStateEnabled(state, enabled)
		end
	end
	
	local function stopFlyLoop()
		if FlyConnection then
			FlyConnection:Disconnect()
			FlyConnection = nil
		end
	
		if FlyPhysicsConnection then
			FlyPhysicsConnection:Disconnect()
			FlyPhysicsConnection = nil
		end
	end
	
	local function resetFly()
		Flying = false
	
		stopFlyLoop()
		clearKeys()
	
		CurrentVel = Vector3.zero
		HoldY = nil
	
		if Humanoid and Humanoid.Parent then
			Humanoid.PlatformStand = false
			Humanoid.AutoRotate = true
	
			setFallStates(true)
	
			Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	
		local part = getFlyPart()
	
		if part then
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
	
			task.defer(function()
				if part and part.Parent then
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
			end)
		end
	end
	
	local function startFly()
		if Flying or not HRP or not Humanoid then
			return
		end
	
		Flying = true
		HoldY = nil
	
		SPEED = getSpeed()
		CurrentVel = Vector3.zero
	
		CurrentYaw = math.atan2(
			-HRP.CFrame.LookVector.X,
			-HRP.CFrame.LookVector.Z
		)
	
		local inVehicle = Humanoid.SeatPart ~= nil
	
		if not inVehicle then
			Humanoid.PlatformStand = true
			Humanoid.AutoRotate = false
			setFallStates(false)
		end
	
		local function flyStep(dt)
			if not Flying then
				local part = getFlyPart()
	
				if part then
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
	
				return
			end
	
			if not HRP or not Humanoid or Humanoid.Health <= 0 then
				return
			end
	
			local part = getFlyPart()
	
			if not part then
				return
			end
	
			local move = getMoveVector()
	
			local alpha = math.clamp(
				ACCEL * dt,
				0,
				1
			)
	
			if move.Magnitude > 0 then
				HoldY = nil
	
				local targetVel = move * SPEED
	
				CurrentVel = CurrentVel:Lerp(
					targetVel,
					alpha
				)
	
				part.AssemblyLinearVelocity = CurrentVel
				part.AssemblyAngularVelocity = Vector3.zero
	
				local flatMove = Vector3.new(
					move.X,
					0,
					move.Z
				)
	
				if flatMove.Magnitude > 0.1 then
					local targetYaw = math.atan2(
						-flatMove.X,
						-flatMove.Z
					)
	
					local diff = math.atan2(
						math.sin(targetYaw - CurrentYaw),
						math.cos(targetYaw - CurrentYaw)
					)
	
					CurrentYaw += diff * math.clamp(
						TURN_SPEED * dt,
						0,
						1
					)
	
					part.CFrame =
						CFrame.new(part.Position)
						*
						CFrame.Angles(0, CurrentYaw, 0)
				end
	
			else
				if not HoldY then
					HoldY = part.Position.Y
				end
	
				CurrentVel = Vector3.zero
	
				local pos = part.Position
	
				part.CFrame =
					CFrame.new(
						pos.X,
						HoldY,
						pos.Z
					)
					*
					part.CFrame.Rotation
	
				part.AssemblyLinearVelocity = Vector3.zero
			end
		end
	
		FlyConnection = RunService.RenderStepped:Connect(flyStep)
	
		FlyPhysicsConnection = RunService.PostSimulation:Connect(function()
			local part = getFlyPart()
	
			if not part then
				return
			end
	
			part.AssemblyAngularVelocity = Vector3.zero
	
			if not Flying then
				part.AssemblyLinearVelocity = Vector3.zero
			end
		end)
	end
	
	local function toggleFly()
		SPEED = getSpeed()
	
		if Flying then
			resetFly()
	
			uiStroke.Color = Color3.fromRGB(255,255,255)
		else
			if not HRP or not Humanoid then
				return
			end
	
			startFly()
	
			uiStroke.Color = Color3.fromRGB(0,255,0)
		end
	end
	
	local function setKey(key, down)
		if not inputAllowed() then
			return
		end
	
		Keys[key] = down
	end
	
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
	
		local key = input.KeyCode
	
		if key == Enum.KeyCode.X then
			if inputAllowed() or Flying then
				toggleFly()
			end
		elseif key == Enum.KeyCode.W then
			setKey("W", true)
		elseif key == Enum.KeyCode.A then
			setKey("A", true)
		elseif key == Enum.KeyCode.S then
			setKey("S", true)
		elseif key == Enum.KeyCode.D then
			setKey("D", true)
		end
	end)
	
	UserInputService.InputEnded:Connect(function(input, gp)
		if gp then
			return
		end
	
		local key = input.KeyCode
	
		if key == Enum.KeyCode.W then
			setKey("W", false)
		elseif key == Enum.KeyCode.A then
			setKey("A", false)
		elseif key == Enum.KeyCode.S then
			setKey("S", false)
		elseif key == Enum.KeyCode.D then
			setKey("D", false)
		end
	end)
	
	flyButton.MouseButton1Click:Connect(function()
		if inputAllowed() or Flying then
			toggleFly()
		end
	end)
	
	local function onCharacter(char)
		resetFly()
	
		Humanoid = char:WaitForChild("Humanoid")
		HRP = char:WaitForChild("HumanoidRootPart")
	
		uiStroke.Color = Color3.fromRGB(255,255,255)
	end
	
	if LocalPlayer.Character then
		onCharacter(LocalPlayer.Character)
	end
	
	LocalPlayer.CharacterAdded:Connect(onCharacter)
end
coroutine.wrap(PIMTMYA_fake_script)()
local function LVVGMC_fake_script() -- NoSpread.LocalScript 
	local script = Instance.new('LocalScript', NoSpread)

	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	local button = script.Parent
	
	local enabled = false
	local originalSpreads = {}
	
	local oldStroke = button:FindFirstChildOfClass("UIStroke")
	if oldStroke then
		oldStroke:Destroy()
	end
	
	local uiStroke = Instance.new("UIStroke")
	uiStroke.Parent = button
	uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	uiStroke.Thickness = 0.6
	uiStroke.Color = Color3.fromRGB(255,255,255)
	
	local function getAllTools()
		local tools = {}
	
		if player.Backpack then
			for _, obj in ipairs(player.Backpack:GetDescendants()) do
				if obj:IsA("Tool") then
					table.insert(tools, obj)
				end
			end
		end
	
		if player.Character then
			for _, obj in ipairs(player.Character:GetDescendants()) do
				if obj:IsA("Tool") then
					table.insert(tools, obj)
				end
			end
		end
	
		return tools
	end
	
	local function resetAllSpread()
		for tool, value in pairs(originalSpreads) do
			if tool and tool.Parent then
				pcall(function()
					tool:SetAttribute("Spread", value)
				end)
			end
		end
	
		table.clear(originalSpreads)
	end
	
	local function removeSpread()
		for _, tool in ipairs(getAllTools()) do
			local spread = tool:GetAttribute("Spread")
	
			if spread ~= nil then
				if originalSpreads[tool] == nil then
					originalSpreads[tool] = spread
				end
	
				tool:SetAttribute("Spread", 0)
			end
		end
	end
	
	local function start()
		if enabled then
			return
		end
	
		enabled = true
		uiStroke.Color = Color3.fromRGB(0,255,0)
	end
	
	local function stop()
		if not enabled then
			return
		end
	
		enabled = false
		uiStroke.Color = Color3.fromRGB(255,255,255)
		resetAllSpread()
	end
	
	button.MouseButton1Click:Connect(function()
		if enabled then
			stop()
		else
			start()
		end
	end)
	
	task.spawn(function()
		while task.wait(0.1) do
			if enabled then
				removeSpread()
			end
		end
	end)
	
