local function KAFJCI_fake_script() -- Noclip.LocalScript 
	local script = Instance.new('LocalScript', Noclip)

	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local LocalPlayer = Players.LocalPlayer
	local button = script.Parent
	
	local oldStroke = button:FindFirstChild("UIStroke")
	
	if oldStroke then
		oldStroke:Destroy()
	end
	
	local uiStroke = Instance.new("UIStroke")
	uiStroke.Parent = button
	uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	uiStroke.Transparency = 0
	uiStroke.Thickness = 0.6
	uiStroke.Color = Color3.fromRGB(255,255,255)
	
	local noclipEnabled = false
	local connection
	
	local function getVehicle()
		local char = LocalPlayer.Character
	
		if not char then
			return nil
		end
	
		local humanoid = char:FindFirstChildOfClass("Humanoid")
	
		if not humanoid then
			return nil
		end
	
		local seat = humanoid.SeatPart
	
		if seat and (seat:IsA("VehicleSeat") or seat:IsA("Seat")) then
			return seat:FindFirstAncestorOfClass("Model")
		end
	
		return nil
	end
	
	local function setCollision(enabled)
		for _,player in ipairs(Players:GetPlayers()) do
			local char = player.Character
	
			if char then
				for _,part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = enabled
					end
				end
			end
		end
	
		local vehicle = getVehicle()
	
		if vehicle then
			for _,part in ipairs(vehicle:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = enabled
				end
			end
		end
	end
	
	local function stopNoclip()
		if connection then
			connection:Disconnect()
			connection = nil
		end
	
		setCollision(true)
	end
	
	local function startNoclip()
		if not getVehicle() then
			noclipEnabled = false
			uiStroke.Color = Color3.fromRGB(255,255,255)
			return
		end
	
		stopNoclip()
	
		setCollision(false)
	
		connection = RunService.RenderStepped:Connect(function()
			if noclipEnabled then
				if not getVehicle() then
					stopNoclip()
					noclipEnabled = false
					uiStroke.Color = Color3.fromRGB(255,255,255)
					return
				end
	
				setCollision(false)
			end
		end)
	end
	
	local function toggleNoclip()
		if not getVehicle() then
			return
		end
	
		noclipEnabled = not noclipEnabled
	
		if noclipEnabled then
			uiStroke.Color = Color3.fromRGB(0,255,0)
			startNoclip()
		else
			uiStroke.Color = Color3.fromRGB(255,255,255)
			stopNoclip()
		end
	end
	
	button.MouseButton1Click:Connect(toggleNoclip)
	
	LocalPlayer.CharacterAdded:Connect(function()
		if noclipEnabled then
			task.wait(0.5)
			startNoclip()
		end
	end)
end
