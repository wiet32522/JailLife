local function RBDHPY_fake_script() -- TptoCar.LocalScript 
	local script = Instance.new('LocalScript', TptoCar)

	local Players = game:GetService("Players")
	
	local LocalPlayer = Players.LocalPlayer
	local button = script.Parent
	
	local oldStroke = button:FindFirstChild("UIStroke")
	
	if oldStroke then
		oldStroke:Destroy()
	end
	
	local uiStroke = Instance.new("UIStroke")
	uiStroke.Parent = button
	uiStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	uiStroke.Transparency = 0
	uiStroke.Thickness = 0.6
	uiStroke.Color = Color3.fromRGB(255,255,255)
	
	local enabled = false
	
	local MIN_Y = -39
	
	local Event = game:GetService("ReplicatedStorage").Networking.ByteNetMax.system.ByteNetQuery
	
	local function fireEvent()
		Event:InvokeServer(
			(function(bytes)
				local b = buffer.create(#bytes)
				for i = 1, #bytes do
					buffer.writeu8(b, i - 1, bytes[i])
				end
				return b
			end)({4,1,0,6,0,83,101,110,116,97,114}),
			{
				workspace.VehicleButtons:GetChildren()[2]
			},
			4
		)
	end
	
	local function findMyVehicle()
		local spawnedVehicles = workspace:WaitForChild("SpawnedVehicles")
	
		for _, vehicle in ipairs(spawnedVehicles:GetChildren()) do
			if vehicle:IsA("Model") then
				if vehicle:GetAttribute("Owner") == LocalPlayer.UserId then
					return vehicle
				end
			end
		end
	end
	
	local function getDriverSeat()
		local vehicle = findMyVehicle()
	
		if vehicle then
			local seat = vehicle:FindFirstChild("DriverSeat", true)
	
			if seat and seat:IsA("BasePart") then
				return seat
			end
		end
	end
	
	local function safeCFrame(cf)
		local pos = cf.Position
	
		if pos.Y < MIN_Y then
			return CFrame.new(
				pos.X,
				MIN_Y + 5,
				pos.Z
			)
		end
	
		return cf
	end
	
	local function teleportToDriverSeat()
		local driverSeat = getDriverSeat()
	
		if driverSeat then
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	
			if hrp and humanoid then
				hrp.CFrame = safeCFrame(driverSeat.CFrame * CFrame.new(0,2,0))
	
				task.wait(0.05)
	
				driverSeat:Sit(humanoid)
	
				local start = tick()
	
				while tick() - start < 0.5 do
					if humanoid.SeatPart == driverSeat then
						break
					end
	
					hrp.CFrame = safeCFrame(driverSeat.CFrame * CFrame.new(0,2,0))
	
					task.wait()
				end
			end
		end
	end
	
	local function setPrompt()
		local vehicle = findMyVehicle()
	
		if vehicle then
			local chassis = vehicle:FindFirstChild("Chassis")
	
			if chassis then
				local base = chassis:FindFirstChildWhichIsA("BasePart")
	
				if base then
					local attachment = base:FindFirstChild("DrivePromptAttachment")
	
					if attachment then
						local prompt = attachment:FindFirstChild("DrivePrompt")
	
						if prompt then
							prompt.HoldDuration = 0
						end
					end
				end
			end
		end
	end
	
	local function toggle()
		enabled = not enabled
	
		if enabled then
			uiStroke.Color = Color3.fromRGB(0,255,0)
	
			fireEvent()
	
			task.wait(0.5)
	
			setPrompt()
	
			task.spawn(function()
				local start = tick()
	
				while enabled and tick() - start < 1 do
					local driverSeat = getDriverSeat()
	
					if driverSeat then
						local prompt = driverSeat:FindFirstChildOfClass("ProximityPrompt")
	
						if prompt then
							fireproximityprompt(prompt)
						end
					end
	
					task.wait(0.025)
				end
			end)
	
			task.wait(0.1)
	
			teleportToDriverSeat()
	
		else
			uiStroke.Color = Color3.fromRGB(255,255,255)
		end
	end
	
	button.MouseButton1Click:Connect(toggle)
end
